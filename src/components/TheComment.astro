<script>
  import { init } from "sodesu-comment";
  import "sodesu-comment/sodesu-comment.css";
  let baseURL = import.meta.env.BASE_URL;
  let path = window.location.pathname.replace(new RegExp("^" + baseURL), "");
  if (path === "") {
    path = "/";
  }

  init({
    el: "#sodesu",
    serverURL: "blog-comments.yixuan-wang.site",
    dark: "html.dark",
    lang: "en",
    path,
  });
</script>

<div id="sodesu"></div>

