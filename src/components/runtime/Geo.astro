---
import GeoComponent from "./geo/Geo.svelte";

const { lat, long, zoom, interactive } = Astro.props;

const view = [Number.parseFloat(lat ?? "39.9935"), Number.parseFloat(long ?? "116.303873")];
const zoomLevel = Number.parseInt(zoom ?? "17");
---

<div class="w-full aspect-ratio-video">
  <GeoComponent
    client:only="svelte"
    {view}
    zoom={zoomLevel}
    interactive={interactive}
  />
</div>
