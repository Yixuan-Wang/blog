---
import GeoComponent from "~/components/geo/Geo.svelte";

const { lat, lng, zoom, interactive } = Astro.props;

const view: [number, number] = [Number.parseFloat(lng ?? "116.303873"), Number.parseFloat(lat ?? "39.9935")];
const zoomLevel = Number.parseInt(zoom ?? "16");
---

<div class="w-full aspect-ratio-video">
  <GeoComponent
    client:only="svelte"
    {view}
    zoom={zoomLevel}
    interactive={interactive}
  />
</div>
