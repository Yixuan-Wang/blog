<div class="mermaid-container">
  <div class="mermaid-text" style="background-color: color(from rgba(var(--color-front)) srgb r g b);"></div>
  <div class="mermaid-back" style="background-color: color(from rgba(var(--color-back)) srgb r g b);"></div>
  <div class="mermaid-primary" style="background-color: color(from var(--color-one-back) srgb r g b);"></div>
  <div class="mermaid-secondary" style="background-color: color(from var(--color-two-back) srgb r g b);"></div>
  <script is:inline type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

    function getRgb(className) {
      const colorRaw = window.getComputedStyle(document.getElementsByClassName(className)[0]).backgroundColor.match(/srgb (?<rFrac>[0-9.]+) (?<gFrac>[0-9.]+) (?<bFrac>[0-9.]+)/);
      if (colorRaw) {
        const { rFrac, gFrac, bFrac } = colorRaw.groups;
        const r = Math.round(parseFloat(rFrac) * 255);
        const g = Math.round(parseFloat(gFrac) * 255);
        const b = Math.round(parseFloat(bFrac) * 255);
        return `rgb(${r} ${g} ${b})`;
      }
      return null;
    }

    (function () {
      if (window['mermaidInitialized']) return;
      window['mermaidInitialized'] = true;

      const elementCode = '.mermaid'
      const loadMermaid = () => {
        mermaid.initialize(config())
        mermaid.init(config(), document.querySelectorAll(elementCode))
      }
      const saveOriginalData = () => {
        let els = document.querySelectorAll(elementCode);
        els?.forEach(element => {
          element.setAttribute('data-original-code', element.innerHTML);
        });
      }
      const resetProcessed = () => {
        let els = document.querySelectorAll(elementCode);
        els?.forEach(element => {
          if(element.getAttribute('data-original-code') != null){
            element.removeAttribute('data-processed')
            element.innerHTML = element.getAttribute('data-original-code')
          }
        });
      }

      const config = () => ({
        securityLevel: 'strict',
        theme: 'base',
        fontFamily: 'inherit',
        themeVariables: {
          darkMode: !!document.documentElement.classList.contains('dark'),
          background: getRgb('mermaid-back'),
          primaryTextColor: getRgb('mermaid-text'),
          primaryColor: getRgb('mermaid-primary'),
          secondaryColor: getRgb('mermaid-secondary'),
        }
      });

      const change = () => {
        resetProcessed();
        loadMermaid();
      };
      const observer = new MutationObserver(change);

      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class'],
      });

      saveOriginalData()
      mermaid.initialize(config());
    })();
  </script>
  <slot></slot>
</div>
