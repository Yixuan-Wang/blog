---
import ColorPaletteButton from "src/components/ColorPaletteButton.svelte";
import BaseHover from "src/components/BaseHover.astro";
import type { ColorPaletteSetting } from "src/stores/color-palette";
import { DEFAULT_COLOR_PALETTE } from "src/logic/color-palette-default";

interface PrebuildColorPalette extends ColorPaletteSetting {
  name: string;
}

const prebuiltColorPalettes: PrebuildColorPalette[] = [
  {
    name: "Flame",
    one: {
      mode: "oklch",
      l: 0.61,
      c: 0.25,
      h: 26,
    },
    two: {
      mode: "oklch",
      l: 0.6926,
      c: 0.242,
      h: 18,
    },
  },
  {
    name: "Honey",
    one: {
      mode: "oklch",
      l: 0.7701,
      c: 0.22,
      h: 57,
    },
    two: {
      mode: "oklch",
      l: 0.8222,
      c: 0.25,
      h: 80,
    },
  },
  {
    name: "Chloroplast",
    one: {
      mode: "oklch",
      l: 0.5676,
      c: 0.225,
      h: 126,
    },
    two: {
      mode: "oklch",
      l: 0.6626,
      c: 0.16,
      h: 150,
    },
  },
  {
    name: "Ocean",
    ...(DEFAULT_COLOR_PALETTE as ColorPaletteSetting),
  },
  {
    name: "Dream",
    one: {
      mode: "oklch",
      l: 0.3875,
      c: 0.22,
      h: 273,
    },
    two: {
      mode: "oklch",
      l: 0.6138,
      c: 0.25,
      h: 296,
    },
  },
  {
    name: "Rock",
    one: {
      mode: "oklch",
      l: 0.512,
      c: 0.056,
      h: 220,
    },
    two: {
      mode: "oklch",
      l: 0.55,
      c: 0.055,
      h: 159,
    },
  },
];

const sihouetteColorPalette: PrebuildColorPalette = {
  name: "Sihouette",
  one: {
    mode: "oklch",
    l: 0.3211,
    c: 0.0,
    h: 0.0,
  },
  two: {
    mode: "oklch",
    l: 0.8975,
    c: 0.0,
    h: 0.0,
  },
};
---

<div class="py-1 flex flex-row flex-wrap gap-2 items-center">
  {
    prebuiltColorPalettes.map((color, index) => (
      <BaseHover>
        <ColorPaletteButton
          slot="handle"
          client:idle
          palette={color}
          title={color.name}
        />
        <div
          slot="content"
          class="px-1.5 py-1 rounded text-sm"
          style={{
            "--color": `oklch(60% ${color.one.c} ${color.one.h})`,
            color: "oklch(from var(--color) 90% calc(c * 0.75) h)",
            "background-color": "oklch(from var(--color) 45% calc(c * 0.45) h)",
          }}
        >
          <span>{color.name}</span>
        </div>
      </BaseHover>
    ))
  }
  <BaseHover>
    <ColorPaletteButton
      slot="handle"
      client:idle
      palette={sihouetteColorPalette}
      title={sihouetteColorPalette.name}
    >
      <div
        style="width: 1.125rem; height: 1.125rem; border-radius: 50%; background: linear-gradient(to right, #333333 50%, #DDDDDD 0);"
      >
      </div>
    </ColorPaletteButton>
    <div
      slot="content"
      class="px-1.5 py-1 rounded text-sm"
      style={{
        "--color": `oklch(60% ${sihouetteColorPalette.one.c} ${sihouetteColorPalette.one.h})`,
        color: "oklch(from var(--color) 90% calc(c * 0.75) h)",
        "background-color": "oklch(from var(--color) 45% calc(c * 0.45) h)",
      }}
    >
      <span>{sihouetteColorPalette.name}</span>
    </div>
  </BaseHover>
</div>
