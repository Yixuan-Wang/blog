---
import { getCollection, getEntry } from 'astro:content';

import LayoutDefault from "src/layouts/LayoutDefault.astro";
import PostInfoBrief from "src/components/PostInfoBrief.astro";
import pl from "nodejs-polars";
// import { Collector } from "src/utils/collector";
// import { getYear } from "date-fns";
import { decideTimeFromStatus } from "~/utils/time";
import { getDataset } from "~/logic/dataset";

const posts = await getCollection("posts");
const dataset = await getDataset();

const datasetYears = dataset.withColumns(
  pl.col("date").str.strptime(pl.Date, "%Y-%m-%d").dt.year().alias("year")
).groupBy("year").agg(
  pl.col("index").sortBy("date", true)
).sort("year", true);

const years: { year: number; posts: post.PostInfo[] }[] = datasetYears.map(([year, index]) => ({
  year,
  posts: index.map((id: number) => posts[id])
}));

// const years = dataset_years.map(row => ({
//   row
// }))


// const years = new Collector<string, string[], string>(
//   () => [],
//   (container, value) => container.push(value),
// );
// timeDesc.forEach(key =>
//   years.add(getYear(decideTimeFromStatus(PostInfo[key].meta)).toString(), key),
// );
---

<LayoutDefault
  title="Archive"
  description="Archive of Yixuan Wang's blog posts."
  noComments={true}
  hasScrollToTop={true}
>
  <div class="flex flex-col gap-8">
    {
      years.map(({ year, posts }) => (
        <section>
          <h2 class="text-3xl font-bold text-one-front">{year}</h2>
          <p class="pb-4 font-mono text-two-front">{posts.length}</p>
          <div class="flex flex-col gap-2">
            {posts.map(post => (
              <PostInfoBrief info={post} timeFormat="MM/dd" />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</LayoutDefault>
