---
import LayoutDefault from "src/layouts/LayoutDefault.astro";
import { getDataset, getPosts } from "~/logic/dataset";
import pl from "nodejs-polars";
import PostInfoFull from "src/components/PostInfoFull.astro";

export async function getStaticPaths() {
  const dataset = await getDataset();
  const allSeriesIds = dataset.filter(pl.col("series").isNotNull()).select(pl.col("series").struct.field("name").unique()).toSeries().toArray() as string[];
  return allSeriesIds.map(series => ({ params: { series } }));
}

const { series } = Astro.params as {
  series: string
};

const dataset = await getDataset();
const allSeries = dataset.filter(pl.col("series").struct.field("name").eq(pl.lit(series)))
  .sort(pl.col("series").struct.field("index"), false)
  .select("id").toSeries().toArray() as string[];
const postInfo = await getPosts(allSeries);
---

<LayoutDefault
  title={series}
  description={`Series ${series} on Yixuan Wang's blog.`}
  hasScrollToTop={true}
>
  <Fragment slot="head"></Fragment>
  <Fragment slot="headline"></Fragment>
  <div class="flex flex-col gap-5">
    {postInfo.map(info => <PostInfoFull info={info} />)}
  </div>
</LayoutDefault>
