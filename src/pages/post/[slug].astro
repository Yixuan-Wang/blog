---
import LayoutDefault from "src/layouts/LayoutDefault.astro";
import path from "node:path";

import "src/styles/post.css";
import { getCollection, getEntry } from "astro:content";
import { render } from "~/build/renderers/md";

import PostMeta from "src/components/PostMeta.astro";
import TheToc from "~/components/TheToc.astro";
import CalloutStatus from "~/components/CalloutStatus.astro";
import { Status } from "~/logic/status";
// import { parseMarkdown } from "~/build/providers/parser";
// import { renderHtml } from "~/build/render";

export async function getStaticPaths() { 
  const posts = await getCollection("posts");
  const slugs = posts.map((post: any) => ({
    params: { slug: post.id },
  }));
  return slugs;
}

const { slug } = Astro.params as {
  slug: string;
};

// const {
//   default: Content,
//   excerpt,
//   metadata: meta,
//   toc,
//   componentNames,
//   // @ts-ignore
// } = await postImport[slug]();

const post = await getEntry("posts", slug)!;
const { Content, toc, features } = await render(post.body!);
---

<!-- <LayoutDefault title={meta.title} description={excerpt} hasScrollToTop={true}> -->
<LayoutDefault title={post.data.title}, description={post.data.excerpt} hasScrollToTop={true}>
  <Fragment slot="head">
    {
      features.has("math") ? (
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/katex@latest/dist/katex.min.css"
          crossorigin="anonymous"
        />
      ) : null
    }

    {
      features.has("mermaid") ? (
        <script is:inline type="module">
          import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
          document.addEventListener("DOMContentLoaded", function() {
            mermaid.initialize({
              securityLevel: 'loose',
              theme: 'neutral',
              fontFamily: 'inherit',
            });
          }); 
        </script>
      ) : null
    }
  </Fragment>
  <Fragment slot="headline">
    <PostMeta meta={post.data} />
  </Fragment>
  <main id="md" lang={post.data.lang}>
    {toc ? <TheToc toc={toc} /> : null}
    <Content>
      <Fragment slot="foldout">
        {
          post.data.status !== "finished" ? (
            <CalloutStatus
              status={post.data.status}
              updated={post.data.timeline.updated}
            />
          ) : null
        }
      </Fragment>
    </Content>
  </main>
  <!-- 
  <main id="md" lang={meta.lang ?? "zh-Hans"}>
    {toc ? <TheToc {toc} /> : null}
    <Content>
      <Fragment slot="foldout">
        {
          meta.status !== Status.FINISHED ? (
            <CalloutStatus
              status={meta.status}
              updated={meta.timeline.updated}
            />
          ) : null
        }
      </Fragment>
    </Content>
  </main> -->
</LayoutDefault>
