---
import LayoutDefault from "src/layouts/LayoutDefault.astro";
import path from "node:path";

import "src/styles/post.css";
import { getCollection, getEntry } from "astro:content";
import { render } from "~/build/renderers/md";

import PostMeta from "src/components/PostMeta.astro";
import TheToc from "~/components/TheToc.astro";
import CalloutStatus from "~/components/CalloutStatus.astro";
import { Genre } from "~/logic/genre";

import SidePanelWaypoint from "~/components/SidePanelWaypoint.astro";

export async function getStaticPaths() { 
  const posts = await getCollection("posts");
  const slugs = posts.map((post: any) => ({
    params: { slug: post.id },
  }));
  return slugs;
}

const { slug } = Astro.params as {
  slug: string;
};

// const {
//   default: Content,
//   excerpt,
//   metadata: meta,
//   toc,
//   componentNames,
//   // @ts-ignore
// } = await postImport[slug]();

const post = await getEntry("posts", slug)!;
const { Content, toc, features, extraInfo } = await render(post.body!, post.data);

let layout = "default";
if (post.data.genre === Genre.WAYPOINT) {
  layout = "side-panel";
}
---

<!-- <LayoutDefault title={meta.title} description={excerpt} hasScrollToTop={true}> -->
<LayoutDefault title={post.data.title}, description={post.data.excerpt} hasScrollToTop={true}>
  <Fragment slot="head">
    {
      features.has("math") ? (
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/katex@latest/dist/katex.min.css"
          crossorigin="anonymous"
        />
      ) : null
    }
  </Fragment>
  <Fragment slot="headline">
    <PostMeta meta={post.data} />
  </Fragment>
  <div id="post" data-layout={layout}>
    { extraInfo?.type === "waypoint" ? <SidePanelWaypoint waypoints={extraInfo.waypoints} /> : null }
    <main id="md" lang={post.data.lang}>
      {toc ? <TheToc toc={toc} /> : null}
      <Content>
        <Fragment slot="foldout">
          {
            post.data.status !== "finished" ? (
              <CalloutStatus
                status={post.data.status}
                updated={post.data.timeline.updated}
              />
            ) : null
          }
        </Fragment>
      </Content>
    </main>
  </div>
</LayoutDefault>

<style>
  [data-layout="side-panel"] {
    display: grid;
  }

  @media (min-width: 1024px) {
    [data-layout="side-panel"] {
      gap: 2rem;
      width: 150%;
      justify-self: center;
      grid-template-columns: 1fr 1fr;

      main {
        grid-row: 1;
        grid-column: 2;
      }

      #md {
        grid-row: 1;
        grid-column: 1;
      }
    }
  }

  @media (min-width: 1280px) {
    [data-layout="side-panel"] {
      width: 175%;
      grid-template-columns: 2fr 3fr;
    }
  }

</style>