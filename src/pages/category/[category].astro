---
import LayoutDefault from "src/layouts/LayoutDefault.astro";
import { getDataset, getPosts } from "~/logic/dataset";
import pl from "nodejs-polars";
import { category as categoryInfo } from "@/meta/category.yaml";
import PostInfoBrief from "~/components/PostInfoBrief.astro";
import TagList from "~/components/TagList.astro";

// import PostMeta from "src/components/PostMeta.astro";

export async function getStaticPaths() {
  const dataset = await getDataset();
  const allCategory = dataset.select(pl.col("category").unique()).toSeries().toArray() as string[];
  return allCategory.map(category => ({ params: { category } }));
}

const { category } = Astro.params as {
  category: string
};

const dataset = await getDataset();
const allCategory = dataset.filter(pl.col("category").eq(pl.lit(category)))
  .select("id").toSeries().toArray() as string[];
const allTags = dataset.filter(pl.col("category").eq(pl.lit(category)))
  .explode("tags")
  .groupBy("tags").agg(
    pl.len().alias("count"),
  ).sort("count", true).toObject() as unknown as {
    tags: string[];
    count: number[];
  };
const postInfo = await getPosts(allCategory);
// const { default: Content, excerpt, metadata: meta } = await postImport[slug]();
---

<LayoutDefault
  title={categoryInfo[category].name}
  description={categoryInfo[category].description}
  hasScrollToTop={true}
>
  <Fragment slot="head"></Fragment>
  <Fragment slot="headline">
    <p>{categoryInfo[category].description}</p>
  </Fragment>
  <main class="flex flex-col gap-5">
    <TagList tags={allTags.tags} counts={allTags.count} />
    <section class="flex flex-col gap-2">
      {
        postInfo.map(info => (
          <PostInfoBrief hideCategory={true} info={info} />
        ))
      }
    </section>
  </main>
</LayoutDefault>
