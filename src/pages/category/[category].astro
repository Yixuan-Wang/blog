---
import LayoutDefault from "src/layouts/LayoutDefault.astro";
import { getCategoriesRecord, getPosts, getTaxonomyRecord } from "~/logic/dataset";
import { category as categoryInfo } from "@/meta/category.yaml";
import PostInfoBrief from "~/components/PostInfoBrief.astro";
import TagList from "~/components/TagList.astro";
import SeriesList from "~/components/SeriesList.astro";

// import PostMeta from "src/components/PostMeta.astro";

export async function getStaticPaths() {
  const allCategory = await getCategoriesRecord();
  return Object.keys(allCategory).map(category => ({ params: { category } }));
}

const { category } = Astro.params as {
  category: string
};

const allCategory = (await getCategoriesRecord())[category];
const { tags, series } = (await getTaxonomyRecord())[category];
const postInfo = await getPosts(allCategory);
---

<LayoutDefault
  title={categoryInfo[category].name}
  description={categoryInfo[category].description}
  hasScrollToTop={true}
>
  <Fragment slot="head"></Fragment>
  <Fragment slot="headline">
    <p>{categoryInfo[category].description}</p>
  </Fragment>
  <main class="flex flex-col gap-5">
    <TagList {tags} />
    <SeriesList {series} />
    <section class="flex flex-col gap-2">
      {
        postInfo.map(info => (
          <PostInfoBrief hideCategory={true} info={info} />
        ))
      }
    </section>
  </main>
</LayoutDefault>
